// ============================================================
// Buy-and-Hold Benchmark — STRAT-06 Cross-Validation (F5.1)
// Chart: BINANCE:BTCUSDT  |  TF: 1D  |  Range: 2017-08-17 → 2026-05-06
// ============================================================
//@version=5
indicator("BAH Benchmark (F5.1)", overlay=false, max_bars_back=5000)

// ── Constants ─────────────────────────────────────────────────────────────────
var float CAPITAL   = 52500.0   // total capital (USDT treated as EUR)
var float FEE_RATE  = 0.001     // 0.1% Binance fee

// ── Start date: 2017-08-17 ────────────────────────────────────────────────────
bool after_start = timestamp("UTC", 2017, 8, 17, 0, 0) <= time

// ── State ─────────────────────────────────────────────────────────────────────
var float btc_held  = 0.0
var float cash      = 0.0
var bool  bought    = false

// ── Lump-sum buy on first bar ─────────────────────────────────────────────────
if after_start and not bought and close > 0
    float spend    = CAPITAL
    btc_held      := spend * (1.0 - FEE_RATE) / close
    cash          := spend * FEE_RATE  // residual (fee deducted from BTC)
    bought        := true

// ── Portfolio value ───────────────────────────────────────────────────────────
float pv         = after_start ? btc_held * close + cash : na
float cost_basis = btc_held > 0 ? CAPITAL / btc_held : na

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(pv,         "Portfolio €",     color=color.new(color.blue,  0), linewidth=2)
plot(cost_basis, "Avg Cost Basis",  color=color.new(color.gray, 40), linewidth=1)

// ── Dashboard (last bar) ──────────────────────────────────────────────────────
if barstate.islast and after_start
    var table t = table.new(position.top_right, 2, 5,
                            bgcolor=color.new(color.black, 70), border_width=1)
    table.cell(t, 0, 0, "Buy-and-Hold",    text_color=color.white,  text_size=size.normal)
    table.cell(t, 1, 0, "",                text_color=color.white)
    table.cell(t, 0, 1, "Portfolio €",     text_color=color.gray)
    table.cell(t, 1, 1, str.tostring(math.round(pv), "#,###"),           text_color=color.white)
    table.cell(t, 0, 2, "BTC held",        text_color=color.gray)
    table.cell(t, 1, 2, str.tostring(btc_held, "#.####"),                text_color=color.white)
    table.cell(t, 0, 3, "Cost basis €/BTC",text_color=color.gray)
    table.cell(t, 1, 3, str.tostring(math.round(cost_basis), "#,###"),   text_color=color.white)
    table.cell(t, 0, 4, "Return %",        text_color=color.gray)
    table.cell(t, 1, 4, str.tostring(math.round((pv / CAPITAL - 1) * 100), "#,###") + "%",
                                                                          text_color=color.lime)

// ── Reference line (total invested) ──────────────────────────────────────────
hline(CAPITAL, "Invested €52,500", color=color.new(color.gray, 60), linestyle=hline.style_dashed)
