// ============================================================
// DCA Benchmark — STRAT-06 Cross-Validation (F5.1)
// Chart: BINANCE:BTCUSDT  |  TF: 1D  |  Range: 2017-08-17 → 2026-05-06
// ============================================================
//@version=5
indicator("DCA Benchmark (F5.1)", overlay=false, max_bars_back=5000)

// ── Constants ─────────────────────────────────────────────────────────────────
var float MONTHLY_INFLOW = 500.0
// Weekly spend = monthly × 12 / 52 (annualised weekly equivalent)
var float WEEKLY_SPEND   = MONTHLY_INFLOW * 12.0 / 52.0   // ≈ 115.38
var float FEE_RATE       = 0.001
var float MIN_ORDER      = 10.0

// ── Start date: 2017-08-17 ────────────────────────────────────────────────────
bool after_start = timestamp("UTC", 2017, 8, 17, 0, 0) <= time

// ── State ─────────────────────────────────────────────────────────────────────
var float pool_cash     = 0.0   // accumulated inflows pending deployment
var float btc_held      = 0.0
var float total_spent   = 0.0   // EUR deployed to BTC (ex-fees)
var float total_inflows = 0.0

// ── Monthly inflow (first bar of each month) ──────────────────────────────────
bool new_month = after_start and (ta.change(month) != 0 or (bar_index == 0 and after_start))

if new_month
    pool_cash      := pool_cash + MONTHLY_INFLOW
    total_inflows  := total_inflows + MONTHLY_INFLOW

// ── Weekly buy (every Monday) ─────────────────────────────────────────────────
bool is_monday = dayofweek == dayofweek.monday

if after_start and is_monday and close > 0 and pool_cash >= MIN_ORDER
    float spend    = math.min(pool_cash, WEEKLY_SPEND)
    if spend >= MIN_ORDER
        float btc_net  = spend * (1.0 - FEE_RATE) / close
        btc_held      := btc_held  + btc_net
        total_spent   := total_spent + spend
        pool_cash     := pool_cash - spend

// ── Portfolio value ───────────────────────────────────────────────────────────
float pv         = after_start ? btc_held * close + pool_cash : na
float cost_basis = btc_held > 0 ? total_spent / btc_held : na

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(pv,           "Portfolio €",    color=color.new(color.teal,   0), linewidth=2)
plot(total_inflows,"Total Invested", color=color.new(color.gray,  50), linewidth=1, style=plot.style_line)
plot(cost_basis,   "Avg Cost Basis", color=color.new(color.orange,40), linewidth=1)

// ── Dashboard (last bar) ──────────────────────────────────────────────────────
if barstate.islast and after_start
    var table t = table.new(position.top_right, 2, 6,
                            bgcolor=color.new(color.black, 70), border_width=1)
    table.cell(t, 0, 0, "DCA Benchmark",  text_color=color.white,  text_size=size.normal)
    table.cell(t, 1, 0, "",               text_color=color.white)
    table.cell(t, 0, 1, "Portfolio €",    text_color=color.gray)
    table.cell(t, 1, 1, str.tostring(math.round(pv), "#,###"),                text_color=color.white)
    table.cell(t, 0, 2, "BTC held",       text_color=color.gray)
    table.cell(t, 1, 2, str.tostring(btc_held, "#.####"),                     text_color=color.white)
    table.cell(t, 0, 3, "Cost basis €/BTC",text_color=color.gray)
    table.cell(t, 1, 3, str.tostring(math.round(cost_basis), "#,###"),        text_color=color.white)
    table.cell(t, 0, 4, "Cash idle €",    text_color=color.gray)
    table.cell(t, 1, 4, str.tostring(math.round(pool_cash), "#,###"),         text_color=color.yellow)
    table.cell(t, 0, 5, "Return %",       text_color=color.gray)
    float ret_pct = total_inflows > 0 ? (pv / total_inflows - 1) * 100 : 0.0
    table.cell(t, 1, 5, str.tostring(math.round(ret_pct), "#,###") + "%",     text_color=color.lime)

// ── Validation targets ────────────────────────────────────────────────────────
// Expected: BTC ≈ 3.51 [3.33–3.69]  |  Cost basis ≈ €14,973 [€14,224–€15,722]
